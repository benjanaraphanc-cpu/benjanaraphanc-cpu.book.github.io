# คัดลอกไฟล์นี้เป็น .env เพื่อรันในเครื่อง (บน Vercel ให้ตั้งค่าในหน้า Settings > Environment Variables แทน)

# วิธีที่ 1 (แนะนำ): ใช้ DATABASE_URL บรรทัดเดียว
# DATABASE_URL=mysql://user:password@host:3306/dbname

# วิธีที่ 2: แยกค่า (XAMPP ค่าเริ่มต้น user=root รหัสผ่านว่าง)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ku_car_booking

# ข้อความสุ่มยาว ๆ ของคุณเอง (ใช้เซ็นลายเซ็นคุกกี้ล็อกอิน) - บังคับเมื่อขึ้นโฮสต์จริง
SESSION_SECRET=change-this-to-a-long-random-string

# ไม่บังคับ
# DB_SSL=true          # เปิด SSL (ค่าเริ่มต้น: เปิดอัตโนมัติเมื่อขึ้นโฮสต์จริงและฐานข้อมูลไม่ใช่ localhost)
# DB_SSL_VERIFY=false  # ใช้เฉพาะกรณีผู้ให้บริการฐานข้อมูลใช้ใบรับรองที่ระบบไม่รู้จัก
# PORT=3000
